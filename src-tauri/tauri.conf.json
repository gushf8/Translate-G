{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translate G",
  "version": "1.0.1",
  "identifier": "com.translate-g.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Translate G",
        "width": 1250,
        "height": 720,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "ocr",
        "title": "Seleccionar Área para Traducir",
        "url": "ocr.html",
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
